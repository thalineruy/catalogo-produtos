DATABASE_URL=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
CORS_ORIGIN=

# Endereço público das telas. Entra no link de ativação que o novo
# usuário recebe por e-mail; sem isto o link sai quebrado.
URL_SISTEMA=

# Envio de e-mail. Preencha UMA das duas chaves abaixo. Sem nenhuma o
# sistema NÃO quebra: entra em modo simulado, registra no console e
# devolve o link para o administrador repassar à mão.

# Brevo: entrega para qualquer destinatário depois de validar um único
# endereço de remetente, sem exigir domínio próprio. Tem precedência se
# as duas chaves estiverem preenchidas.
BREVO_API_KEY=

# Resend: mais simples, mas com o remetente de teste só entrega para o
# e-mail dono da conta. Para outros destinatários, exige domínio
# verificado.
RESEND_API_KEY=

# Remetente, no formato "Nome <endereco@dominio>".
# Com Brevo: precisa ser um endereço validado no painel deles.
# Com Resend e sem domínio próprio: Catálogo de Produtos <onboarding@resend.dev>
EMAIL_REMETENTE=
