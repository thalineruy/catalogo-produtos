DATABASE_URL=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
CORS_ORIGIN=

# Endereço público das telas. Entra no link de ativação que o novo
# usuário recebe por e-mail; sem isto o link sai quebrado.
URL_SISTEMA=

# Envio de e-mail pelo Brevo. Sem a chave o sistema NÃO quebra: entra em
# modo simulado e mostra o link na tela, para o administrador repassar à
# mão.
#
# A chave sai de SMTP & API -> aba API Keys (não da aba SMTP) e começa
# com "xkeysib-". Lembre de desligar a restrição de IPs autorizados: ela
# vem ligada em contas novas e recusa com 401, igual a chave inválida.
BREVO_API_KEY=

# Remetente, no formato "Nome <endereco@dominio>". Precisa ser um
# endereço validado no painel do Brevo, em Senders, IPs & Domains.
EMAIL_REMETENTE=
